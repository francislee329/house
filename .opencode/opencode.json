{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "bash": {
      "git *": "allow",
      "uv *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "main-architect": {
      "permission": {
        "bash": {
          "git add *": "allow",
          "git commit *": "allow",
          "git push *": "allow",
          "*": "ask"
        }
      }
    }
  }
}
