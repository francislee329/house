    "data": {
      "description": "Scrapes listings, transactions, estate metadata from Centanet/28Hse",
      "script": "agents/data_agent.py",
      "produces": [
        "data/centanet_listings.csv",
        "data/centanet_transactions.csv",
        "data/28hse_listings.csv",
        "data/price_history.csv",
        "data/estates_metadata.json"
      ],
      "depends_on": [],
      "on_change": "rebuild_db"
    },
    "backend": {
      "description": "Seeds DB, runs scoring model, serves FastAPI endpoints",
      "script": "agents/backend_agent.py",
      "produces": [
        "data/hk_flat_finder.db",
        "src/api/main.py"
      ],
      "depends_on": [
        "data"
      ],
      "on_change": "notify_frontend"
    },
    "frontend": {
      "description": "Regenerates API types, updates components if schema changed",
      "script": "agents/frontend_agent.py",
      "produces": [
        "frontend/src/lib/api.ts",
        "frontend/src/components/"
      ],
      "depends_on": [
        "backend"
      ],
      "on_change": null
    }
  },
